#!name=开屏广告发现器（手机临时使用）
#!desc=仅用于未知域名时定位开屏广告接口：临时审计所有 HTTPS JSON 响应，不会修改内容。找到 URL 后请停用本模块，改用“开屏广告拦截器（通用模板）”。
#!category=广告拦截
#!arguments=HOSTNAMES=*&URL_REGEX=^https://[^/][^/]*/.*&SCRIPT_PATH=https://cdn.jsdelivr.net/gh/dqzboy/Images/config/splash-ad-block.js&LEVEL=aggressive&DEBUG=true

[Script]
开屏广告发现（仅审计） = type=http-response, pattern=%URL_REGEX%, requires-body=true, max-size=1048576, script-path=%SCRIPT_PATH%, argument=mode=audit&level=%LEVEL%&debug=%DEBUG%, timeout=5

[MITM]
hostname = %APPEND% %HOSTNAMES%
