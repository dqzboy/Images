#!name=Surge Ad Inspector - Capture Debug
#!desc=调试模式：抓取 HTTPS 请求元数据并上报本地分析器

[MITM]
hostname = %APPEND% -*apple*, -*icloud*, -*.mzstatic.com, *

[Script]
capture-response = type=http-response,pattern=^https:\/\/.*$,script-path=https://raw.githubusercontent.com/dqzboy/Images/main/config/capture-response.js

[Rule]
IP-CIDR,192.168.31.67/32,DIRECT,no-resolve
