#!name=Surge Ad Inspector - Capture
#!desc=将疑似开屏请求的响应上报到本地 Web 分析器。请先修改脚本中的 COLLECTOR。

[MITM]
hostname = %APPEND% *

[Script]
# 初次抓取时可临时放宽 pattern；确认域名后请收窄，避免保存无关响应。
capture-response = type=http-response,pattern=^https:\/\/.*\/(?:splash|startup|launch|ad|creative|material).*$,requires-body=true,script-path=https://cdn.jsdelivr.net/gh/dqzboy/Images/config/capture-response.js,max-size=262144

[Rule]
# 防止上报请求再次被代理回采集器；如使用其他地址，请同步修改。
IP-CIDR,192.168.31.67/32,DIRECT,no-resolve
