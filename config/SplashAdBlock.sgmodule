#!name=开屏广告拦截器（通用模板）
#!desc=对指定 App 的疑似开屏广告 JSON 接口进行保守清理。脚本使用 jsDelivr 远程地址；必须填写真实 HOSTNAMES，建议先用 MODE=audit 观察命中。
#!category=广告拦截
#!arguments=HOSTNAMES=api.example.com&URL_REGEX=^https://[^/][^/]*/.*(splash|startup|launch|open.screen|opening|boot|welcome|advert|ads).*&SCRIPT_PATH=https://cdn.jsdelivr.net/gh/dqzboy/Images/config/splash-ad-block.js&MODE=audit&LEVEL=safe&DEBUG=true

[Script]
开屏广告响应清理 = type=http-response, pattern=%URL_REGEX%, requires-body=true, max-size=1048576, script-path=%SCRIPT_PATH%, argument=mode=%MODE%&level=%LEVEL%&debug=%DEBUG%, timeout=5

[MITM]
hostname = %APPEND% %HOSTNAMES%
